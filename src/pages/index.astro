---
import Seo from '../components/Seo.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Juan Pablo Bascur Cifuentes',
  url: 'https://jpbascur.com/',
  jobTitle: 'Senior Data Analyst',
  worksFor: {
    '@type': 'Organization',
    name: 'Elsevier',
    url: 'https://www.elsevier.com/',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Leiden University',
    url: 'https://www.universiteitleiden.nl/en',
  },
  sameAs: [
    'https://orcid.org/0000-0002-4077-1024',
    'https://scholar.google.com/citations?user=8oH7CMsAAAAJ',
  ],
  knowsAbout: [
    'Data science',
    'Scientometrics',
    'Information retrieval',
    'Machine learning',
    'Natural language processing',
    'Data visualization',
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title="Juan Pablo Bascur" description="Juan Pablo Bascur's professional work, publications, projects, CV, and creative writing." />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { background: #f8f7fa; }
      body { min-height: 100vh; color: #191919; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
      .landing { max-width: 1040px; min-height: 100vh; margin: auto; padding: 72px 48px 46px; }
      .identity { max-width: 700px; margin: 0 auto 38px; text-align: center; }
      .kicker { margin-bottom: 12px; color: #777; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
      h1 { margin-bottom: 14px; font-size: clamp(38px, 6vw, 64px); font-weight: 600; letter-spacing: -.035em; }
      .bio { color: #666; font-size: 15px; line-height: 1.7; }
      .spaces { display: grid; grid-template-columns: 1fr 1fr; overflow: hidden; border-radius: 26px; box-shadow: 0 24px 70px rgba(24,20,40,.15); }
      .space {
        min-height: 330px;
        padding: 38px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        color: inherit;
        text-align: center;
        text-decoration: none;
        transition: transform .2s ease;
      }
      .space:hover { z-index: 2; transform: scale(1.012); }
      .professional { background: #6357c7; color: #fff; }
      .personal { background: #191919; color: #f4efe6; }
      .space-name { max-width: 320px; font-size: 34px; font-weight: 650; letter-spacing: -.025em; }
      .space-summary { max-width: 300px; margin-top: 12px; font-size: 13px; line-height: 1.55; opacity: .72; }
      .fast {
        margin-top: 24px;
        padding: 18px 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        border: 1px solid #e3e0e8;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 10px 30px rgba(24,20,40,.06);
      }
      .fast-label { flex: none; color: #999; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
      .fast-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 20px; }
      .fast-list a { color: #666; font-size: 13px; text-decoration: none; }
      .fast-list a:hover { color: #181818; text-decoration: underline; }
      @media (max-width: 700px) {
        .landing { padding: 52px 20px 32px; }
        .spaces { grid-template-columns: 1fr; }
        .space { min-height: 250px; }
        .fast { align-items: flex-start; flex-direction: column; gap: 12px; }
        .fast-list { justify-content: flex-start; }
      }
    </style>
  </head>
  <body>
    <main class="landing">
      <header class="identity">
        <div class="kicker">Data · Research · Writing</div>
        <h1>Juan Pablo Bascur</h1>
        <p class="bio">Senior Data Analyst at Elsevier with a background in data science, scientometrics, information retrieval, and research analytics. I also enjoy creative writing and coding.</p>
      </header>
      <section class="spaces" aria-label="Choose a space">
        <a class="space professional" href="/professional/">
          <strong class="space-name">Professional space</strong>
          <span class="space-summary">Work, research and tools</span>
        </a>
        <a class="space personal" href="/personal/">
          <strong class="space-name">Personal space</strong>
          <span class="space-summary">Stories, interests and experiments</span>
        </a>
      </section>
      <nav class="fast" aria-label="Fast links">
        <span class="fast-label">Fast links</span>
        <div class="fast-list">
          <a href="/work-history/">Work history</a>
          <a href="/publications/">Publications &amp; projects</a>
          <a href="/writing/">Creative writing</a>
          <a href="/files/cv.pdf">CV ↗</a>
        </div>
      </nav>
    </main>
  </body>
</html>
