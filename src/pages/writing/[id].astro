---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map(story => ({ params: { id: story.id }, props: { story } }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const isReport = story.data.presentation === 'report';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{story.data.title} — Juan Pablo Bascur</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Georgia', serif; background: #1a1a1a; color: #f5f0e8; min-height: 100vh; padding: 2.5rem 1.5rem; }
      nav { display: flex; justify-content: space-between; align-items: center; max-width: 680px; margin: 0 auto 4rem; }
      nav a { font-size: 13px; color: #555; text-decoration: none; font-family: system-ui, sans-serif; }
      nav a:hover { color: #f5f0e8; }
      .content { max-width: 680px; margin: 0 auto; }
      .note { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: #444; font-family: system-ui, sans-serif; margin-bottom: 1.25rem; }
      h1 { font-size: 40px; font-weight: 400; line-height: 1.2; margin-bottom: 2.5rem; }
      .prose { font-size: 18px; color: #c8c0b0; line-height: 1.85; }
      .prose p { margin-bottom: 1.5rem; }
      .prose em { color: #f5f0e8; font-style: italic; }
      .prose strong { color: #f5f0e8; font-weight: 600; }
      .prose h2 { color: #f5f0e8; font-size: 26px; font-weight: 400; line-height: 1.3; margin: 3.75rem 0 1.5rem; scroll-margin-top: 2rem; }
      .prose hr { border: 0; border-top: 1px solid #38342e; margin: 3.75rem 0; }
      .prose ul { margin: 0 0 1.75rem 1.4rem; }
      .prose li { margin-bottom: 0.8rem; padding-left: 0.35rem; }
      .report-shell { max-width: 760px; }
      .report-shell .note { color: #8e877b; }
      .report-shell h1 { font-size: clamp(38px, 7vw, 56px); margin-bottom: 1rem; }
      .report-rule { border: 0; border-top: 1px solid #4a4339; margin: 2rem 0 3rem; }
      .report-shell .prose { color: #d1c9ba; }
      .report-shell .prose h2 { border-top: 1px solid #39342d; padding-top: 1.25rem; font-family: system-ui, sans-serif; font-size: 20px; font-weight: 650; letter-spacing: 0.025em; }
      .report-shell .prose h3 { color: #a69d8e; font: 650 12px/1.3 system-ui, sans-serif; letter-spacing: 0.12em; text-transform: uppercase; margin: 2.5rem 0 1rem; }
      .report-shell .prose h3[id^="personal-notes"] { color: #ad8e7d; }
      .report-shell .prose .redacted { display: inline-block; background: #070707; color: #d8d0c2; padding: 0.02em 0.35em; font: 600 0.78em/1.4 system-ui, sans-serif; letter-spacing: 0.08em; }
      .report-shell .prose :global(ul) { margin: 0 0 2rem 1.4rem; }
      .report-shell .prose :global(ul li) { margin-bottom: 0.65rem; padding-left: 0.25rem; }
      @media (max-width: 600px) { body { padding: 1.75rem 1.1rem; } nav { margin-bottom: 3rem; } .prose { font-size: 17px; line-height: 1.78; } }
    </style>
  </head>
  <body>
    <nav>
      <a href="/writing">← Stories</a>
    </nav>
    <div class:list={["content", { "report-shell": isReport }]}>
      {story.data.note && <div class="note">{story.data.note}</div>}
      <h1>{story.data.title}</h1>
      {isReport && <hr class="report-rule" />}
      <div class="prose">
        <Content />
      </div>
    </div>
  </body>
</html>
